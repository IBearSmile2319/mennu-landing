---
import { Image } from "astro:assets";
import Typography from "./ui/typography/Typography.astro";
import type { ImageMetadata } from "astro";
interface Props {
  title: string;
  description: string;
  textBtn: string;
  url: string;
  imgBeforeCts?: ImageMetadata;
  imgBeforeWidth?: number;
  imgBeforeHeight?: number;
  imgBeforeAlt?: string;
  imgs: {
    // src: ImageMetadata;
    src: ImageMetadata;
    alt: string;
    width: number;
    height: number;
    widthMobile: number;
    heightMobile: number;
  }[];
  redirectStoresComensal?: boolean;
  redirectStoresNegocio?: boolean;
  centerTitle?: boolean;
  linkPromo?: string;
  textPromo?: string;
  classTitle?: string;
  classDescription?: string;
  imgBeforeContentClass?: string;
}

const {
  title,
  description,
  textBtn,
  url,
  imgs,
  redirectStoresComensal,
  redirectStoresNegocio,
  centerTitle = true,
  linkPromo,
  textPromo,
  classTitle,
  // nuevos
  imgBeforeCts,
  imgBeforeWidth,
  imgBeforeHeight,
  imgBeforeAlt,
  imgBeforeContentClass,
  classDescription,
} = Astro.props;

const mb = imgs.length > 1 ? "mb-10 lg:mb-20 mr-4" : "mb-0";
const mt = imgs.length > 1 ? "mt-10 lg:mt-20" : "mt-0";
---

<section class="flex lg:h-[612px] mb-4 lg:mb-0">
  <!-- container -->
  <div
    class={`
    w-full 
    mx-auto 
    max-w-[1280px] 
    flex 
    items-center 
    xs:flex-col-reverse 
    sm:flex-row 
    lg:gap-6 
    gap-4
    `}
  >
    <!-- info container -->
    <div
      class="flex flex-col justify-center w-full h-full gap-4 items-center px-4"
    >
      <!-- h1 -->
       {
        title &&
        <Typography
          variant="heading"
          weight="large"
          align={centerTitle ? "center" : "left"}
          class={`${classTitle} font-semibold w-[343px]`}
        >
          {title}
        </Typography>
       }
      <!-- h2 -->
      {
        description && (
          <Typography
            variant="heading"
            weight="xSmall"
            color="gray600"
            class={`${classDescription} w-[343px]`}
          >
            {description}
          </Typography>
        )
      }
      {
        imgBeforeCts && (
          <div class={imgBeforeContentClass}>
            <Image
              src={imgBeforeCts}
              alt={imgBeforeAlt || ""}
              width={imgBeforeWidth}
              height={imgBeforeHeight}
            />
          </div>
        )
      }
      <!-- button -->
      <a
        href={url}
        id={redirectStoresComensal
          ? "redirectStoresComensal"
          : redirectStoresNegocio
            ? "redirectStoreNegocio"
            : ""}
        class={`w-[343px] h-[56px] bg-primary flex flex-row items-center justify-center rounded`}
      >
        <Typography variant="label" weight="large" color="white" align="center">
          {textBtn}
        </Typography>
      </a>
      {
        linkPromo && (
          <a
            href={linkPromo}
            class={`w-[343px] h-[56px] bg-white border-accent border-2 flex flex-row items-center justify-center rounded`}
          >
            <Typography
              variant="label"
              weight="large"
              color="accent"
              align="center"
            >
              {textPromo}
            </Typography>
          </a>
        )
      }
    </div>
    <!-- imgs rounds -->
    <div
      class={`flex items-center ${imgs.length === 1 ? "justify-center my-4" : " lg:justify-center h-[316px] mt-4 lg:mt-0"} w-full lg:h-full lg:py-20 gap-4 items-center flex-row-reverse`}
    >
      <!-- <div class="w-328 h-316 lg:hidden flex flex-row-reverse"> -->
      {
        imgs.map((img, i) => (
          <>
            <img
              src={img.src.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              class:list={[
                // margin bottom al segundo
                i === 0 ? mb : "",
                i === 1 ? mt : "",
                "hidden lg:block",
              ]}
            />
            <img
              src={img.src.src}
              alt={img.alt}
              width={img.widthMobile}
              height={img.heightMobile}
              class={""}
              class:list={[i === 0 ? mb : "", i === 1 ? mt : "", "lg:hidden"]}
            />
          </>
        ))
      }
      <!-- </div> -->
    </div>
  </div>
</section>

<script>
  import { $ } from "@/lib/dom-selector";
  import {
    ANDROID_APP_URL_COMENSAL,
    IOS_APP_URL_COMENSAL,
    ANDROID_APP_URL_NEGOCIO,
    IOS_APP_URL_NEGOCIO,
  } from "@/consts/appStorePaths";
  function toggleMenu() {
    const isIOS = navigator.userAgent.match(/iPhone|iPad|iPod|Macintosh/i);
    let pathComensal = "";
    let pathNegocio = "";
    if (isIOS) {
      pathComensal = IOS_APP_URL_COMENSAL;
      pathNegocio = IOS_APP_URL_NEGOCIO;
    } else {
      pathComensal = ANDROID_APP_URL_COMENSAL;
      pathNegocio = ANDROID_APP_URL_NEGOCIO;
    }

    const redirectStoresComensal: URL = $("#redirectStoresComensal") as any;
    // agregar url al href
    if (redirectStoresComensal) {
      redirectStoresComensal.href = pathComensal;
    }

    const redirectStoresNegocio: URL = $("#redirectStoreNegocio") as any;
    // agregar url al href
    if (redirectStoresNegocio) {
      redirectStoresNegocio.href = pathNegocio;
    }
  }

  // ejecutar al cargar la pagina y al finalizar la animacion solo funciona para google chrome
  window.addEventListener("animationend", toggleMenu);
  window.addEventListener("DOMContentLoaded", toggleMenu);

  document.addEventListener("astro:page-load", toggleMenu);
</script>
