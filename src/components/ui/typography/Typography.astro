---
import type { HTMLTag, Polymorphic } from "astro/types";
import { colors, typography, align as AlingData } from "./types.ts";
type TAlignProps = "left" | "center" | "right" | "justify" | "start" | "end";
type TTypographyVariant = "display" | "heading" | "label" | "paragraph";
type TTypographyWeight =
  | "large"
  | "medium"
  | "small"
  | "xSmall"
  | "xLarge"
  | "xxLarge";
type TColors =
  | "primary"
  | "secondary"
  | "accent"
  | "complementaryI"
  | "complementaryII"
  | "white"
  | "gray700"
  | "gray600"
  | "vividYellow"
  | "darkPink";

type other<Tag extends HTMLTag> = {
  as?: Tag;
};

interface Props extends other<HTMLTag> {
  variant: TTypographyVariant;
  weight: TTypographyWeight;
  align?: TAlignProps;
  color?: TColors;
  class?: string;
}

const {
  as: Tag = "div",
  variant = "display",
  weight = "medium",
  align = "left",
  class: className,
  color = "primary",
} = Astro.props;
---

<Tag
  class:list={[
    typography[variant][weight],
    AlingData[align],
    colors[color],
    className,
  ]}
  tabindex="0"
>
  <slot />
</Tag>
