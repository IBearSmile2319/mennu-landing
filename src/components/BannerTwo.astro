---
import Typography from "./ui/typography/Typography.astro";
import type { ImageMetadata } from "astro";
interface Props {
  title: string;
  textBtn: string;
  url: string;
  redirectStoresComensal?: boolean;
  redirectStoresNegocio?: boolean;
  centerTitle?: boolean;
  linkPromo?: string;
  textPromo?: string;
  classTitle?: string;
  classDescription?: string;
  imgs?: {
    src: ImageMetadata;
    alt: string;
    width: number;
    height: number;
    widthMobile: number;
    heightMobile: number;
  }[];
}

const {
  title,
  textBtn,
  url,
  redirectStoresComensal,
  redirectStoresNegocio,
  centerTitle = true,
  linkPromo,
  textPromo,
  classTitle,
  imgs,
} = Astro.props;
---

<section class="flex mb-4 lg:mb-0">
  <!-- container -->
  <div
    class={`
    w-full 
    mx-auto 
    max-w-[1280px] 
    flex
    flex-col
    lg:gap-6 
    gap-4
    `}
  >
    <!-- info container -->
    <div class="flex flex-col w-full h-full gap-6 px-4 py-8">

     
      <!-- imagenes -->
      {
        imgs && (
          <div class="flex flex-row flex-wrap gap-4 lg:gap-8 justify-center">
            {imgs.map((img, i) => (
              <>
                <img
                  src={img.src.src}
                  alt={img.alt}
                  width={img.width}
                  height={img.height}
                  class:list={["hidden lg:block"]}
                />
                <img
                  src={img.src.src}
                  alt={img.alt}
                  width={img.widthMobile}
                  height={img.heightMobile}
                  class={""}
                  class:list={["lg:hidden"]}
                />
              </>
            ))}
          </div>
        )
      }
    </div>
     <!-- button -->
     <div
     class="flex flex-row flex-wrap gap-4 justify-center"
   >
     <a
       href={url}
       id={redirectStoresComensal
         ? "redirectStoresComensal"
         : redirectStoresNegocio
           ? "redirectStoreNegocio"
           : ""}
       class={`w-[220px] h-[48px] bg-primary flex flex-row items-center justify-center rounded`}
     >
       <Typography
         variant="label"
         weight="large"
         color="white"
         align="center"
       >
         {textBtn}
       </Typography>
     </a>
     {
       linkPromo && (
         <a
           href={linkPromo}
           class={`w-[220px] h-[48px] bg-white border-accent border-2 flex flex-row items-center justify-center rounded`}
         >
           <Typography
             variant="label"
             weight="large"
             color="accent"
             align="center"
           >
             {textPromo}
           </Typography>
         </a>
       )
     }
   </div>
  </div>
</section>

<script>
  import { $ } from "@/lib/dom-selector";
  import {
    ANDROID_APP_URL_COMENSAL,
    IOS_APP_URL_COMENSAL,
    ANDROID_APP_URL_NEGOCIO,
    IOS_APP_URL_NEGOCIO,
  } from "@/consts/appStorePaths";
  function toggleMenu() {
    const isIOS = navigator.userAgent.match(/iPhone|iPad|iPod|Macintosh/i);
    let pathComensal = "";
    let pathNegocio = "";
    if (isIOS) {
      pathComensal = IOS_APP_URL_COMENSAL;
      pathNegocio = IOS_APP_URL_NEGOCIO;
    } else {
      pathComensal = ANDROID_APP_URL_COMENSAL;
      pathNegocio = ANDROID_APP_URL_NEGOCIO;
    }

    const redirectStoresComensal: URL = $("#redirectStoresComensal") as any;
    // agregar url al href
    if (redirectStoresComensal) {
      redirectStoresComensal.href = pathComensal;
    }

    const redirectStoresNegocio: URL = $("#redirectStoreNegocio") as any;
    // agregar url al href
    if (redirectStoresNegocio) {
      redirectStoresNegocio.href = pathNegocio;
    }
  }

  // ejecutar al cargar la pagina y al finalizar la animacion solo funciona para google chrome
  window.addEventListener("animationend", toggleMenu);
  window.addEventListener("DOMContentLoaded", toggleMenu);

  document.addEventListener("astro:page-load", toggleMenu);
</script>
